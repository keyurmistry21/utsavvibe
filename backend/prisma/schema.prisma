generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// One row per selling region. Money is always integer minor units (pence/cents).
model Market {
  id           String         @id @default(cuid())
  code         String         @unique // UK, US, CA
  name         String
  currency     String // GBP, USD, CAD
  countries    String @db.Text // JSON array of ISO codes
  taxRateBps   Int            @default(0) // 2000 = 20%
  taxInclusive Boolean        @default(false)
  active       Boolean        @default(true)
  shippingRates ShippingRate[]
  regions      MarketRegion[]
  prices       VariantPrice[]
  stockLevels  InventoryLevel[]
  products     ProductMarket[]
  orders       Order[]
}

// Provinces/states with their own tax rate (Canada: GST/HST/PST/QST combined).
model MarketRegion {
  id         String @id @default(cuid())
  marketId   String
  market     Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  code       String
  name       String
  taxRateBps Int    @default(0)
  components String? @db.Text // JSON [{name, bps}] splitting taxRateBps, e.g. GST 500 + PST 700 (shown separately on receipts and in the tax report)

  @@unique([marketId, code])
}

model ShippingRate {
  id            String  @id @default(cuid())
  marketId      String
  market        Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  name          String
  amount        Int
  freeOverAmount Int?
  minDays       Int?
  maxDays       Int?
}

model Product {
  id          String          @id @default(cuid())
  title       String
  handle      String          @unique
  description String @db.Text
  status      String          @default("draft") // draft | active | archived
  vendor      String          @default("")
  productType String          @default("")
  trackInventory  Boolean     @default(true)
  continueSelling Boolean     @default(false) // keep selling when stock runs out
  physical        Boolean     @default(true)  // false = digital/service: no shipping
  chargeTax       Boolean     @default(true)
  seoTitle        String      @default("")
  seoDescription  String?     @db.Text
  tags        String @db.Text // JSON array
  notes       String @db.Text // internal only
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  variants    Variant[]
  markets     ProductMarket[]
  images      ProductImage[]
  collections CollectionProduct[]
  isGiftCard  Boolean         @default(false) // selling this product issues a gift card code (variants = denominations)
}

// Which markets a product is sold in.
model ProductMarket {
  productId String
  marketId  String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  market    Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)
  regions   String? @db.Text // JSON array of region codes the product is sold in; null = whole market

  @@id([productId, marketId])
}

model Variant {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String         @default("Default")
  options   String @db.Text // JSON e.g. {"Size":"M","Color":"Red"}
  sku       String?        @unique
  inventory Int            @default(0)
  weightG   Int            @default(0)
  barcode   String?
  costPerItem Int? // minor units, admin-only
  qrActive  Boolean        @default(true) // false = the printed product QR stops opening this variant (lost/withdrawn label)
  prices    VariantPrice[]
  orderItems OrderItem[]
  levels    InventoryLevel[]
}

// Stock of one variant at one location. Variant.inventory is always the sum of these rows (once a store has locations).
model InventoryLevel {
  variantId  String
  marketId   String
  quantity   Int      @default(0)
  sku        String?  @db.VarChar(64) // this variant's own SKU / barcode for this market: its label adds and removes that market's stock (uniqueness is checked on save)
  barcode    String?  @db.VarChar(64)
  variant    Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@id([variantId, marketId])
  @@index([sku])
  @@index([barcode])
}

// Manual price per variant per market.
model VariantPrice {
  variantId  String
  marketId   String
  amount     Int
  compareAt  Int?
  variant    Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market     Market  @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@id([variantId, marketId])
}

model Customer {
  id              String   @id @default(cuid())
  email           String?  @unique // phone-only customers are allowed
  name            String   @default("")
  phone           String?
  language        String   @default("en")
  acceptsEmail    Boolean  @default(false)
  acceptsSms      Boolean  @default(false)
  acceptsWhatsapp Boolean  @default(false)
  taxExempt       Boolean  @default(false) // "Don't collect tax"
  address         String?  @db.Text // JSON default address
  tags            String   @db.Text
  notes           String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  orders          Order[]
}

model Order {
  id              String      @id @default(cuid())
  number          Int         @unique
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  marketId        String
  market          Market      @relation(fields: [marketId], references: [id])
  currency        String
  subtotal        Int
  tax             Int
  shipping        Int
  total           Int
  shippingName    String      @default("")
  shippingAddress String @db.Text // JSON
  status          String      @default("open") // draft | open | fulfilled | cancelled
  paymentStatus   String      @default("pending") // pending | paid | refunded | failed
  stripeSessionId String?     @unique
  stripePaymentIntentId String?
  discount        Int         @default(0)
  discountNote    String?
  paymentMethod   String? // stripe | cash | bank_transfer | other
  paymentLinkUrl  String?     @db.Text
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?     @db.Text
  packageWeightG  Int?
  shippedAt       DateTime?
  giftCardCode    String?     // gift card applied at checkout
  giftCardAmount  Int         @default(0) // minor units of `total` paid by gift card
  labelUrl        String?     @db.Text // purchased carrier label (PDF)
  labelId         String?     // carrier transaction id (needed to void)
  labelCost       Int?        // minor units, in labelCurrency
  labelCurrency   String?
  riskLevel       String?     // fraud screening: low | medium | high (null = not screened)
  riskNote        String?     @db.Text // human-readable reasons
  recoveryToken   String?     @db.VarChar(64) // abandoned-checkout link (random, 256-bit)
  recoveryEmailAt DateTime?   // when the reminder was sent (once per order)
  taxCalcId       String?     // Stripe Tax calculation id
  channel         String      @default("online") // online | in_store (salesperson sold it by scanning the product QR)
  salespersonId   String?     // AdminUser who made an in-store sale
  salespersonName String?     // name kept on the order so reports survive staff deletion
  locationId      String?     // store location of an in-store sale
  locationName    String?
  taxBreakdown    String?     @db.Text // JSON [{name, amount}] of `tax` by component (GST, PST, ...), set when the order is placed
  discountCode    String?     @db.VarChar(40) // storefront discount code applied (amount is in `discount`)
  clientRef       String?     @unique @db.VarChar(40) // id made by the till for a sale taken offline, so syncing it twice can't create two orders
  metaConsent     Boolean     @default(false) // the shopper accepted marketing cookies at checkout: allows the server-side Meta Conversions API purchase event
  discountReleased Boolean    @default(false) // the code's use was given back (payment failed or expired)
  refundedAmount  Int         @default(0) // minor units refunded so far (paymentStatus becomes `refunded` once it equals total)
  refunds         OrderRefund[]
  tags            String @db.Text
  notes           String @db.Text
  createdAt       DateTime    @default(now())
  items           OrderItem[]

  @@index([recoveryToken])
  @@index([channel, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  title     String
  quantity  Int
  unitPrice Int
  taxable   Boolean @default(true)
  physical  Boolean @default(true) // false = digital/service: no shipping needed
  weightG   Int     @default(0)
  giftCard  Boolean @default(false) // this line sells gift card(s); issued when the order is paid
}

// Single-row-per-name counters (order numbers).
model Counter {
  name  String @id
  value Int    @default(1000)
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  passwordHash String
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  totpSecret   String?   @db.Text // AES-GCM encrypted (see src/secrets.ts); set while enrolling
  totpEnabled  Boolean   @default(false)
  preferredMarket String? @db.VarChar(8) // market code this staff member works in; null = all markets
  allowedLocations String? @db.Text // JSON array of location ids this staff member may sell from and move stock at; null/empty = all
  allowedMarkets  String? @db.Text // JSON array of market codes an admin lets them work in (sell, create orders, record expenses); null/empty = all
  sessions     Session[]
}

// Staff role: a named set of permission keys (see src/permissions.ts). "Owner" is the locked system role with everything.
model Role {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("") @db.VarChar(300)
  permissions String      @db.Text // JSON array of permission keys
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  users       AdminUser[]
}

// Only the sha256 of the cookie token is stored, so a DB leak can't be replayed as a session.
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// Key/value store settings (e.g. ship-from address). Value is JSON.
// Where stock is kept and orders ship from. The default one is printed as the sender on labels and packing slips.
model Location {
  id        String   @id @default(cuid())
  name      String
  marketId  String?  // market whose stock and orders this location serves (null = the market that sells in its country)
  company   String   @default("")
  line1     String   @default("")
  line2     String   @default("")
  city      String   @default("")
  region    String   @default("")
  postcode  String   @default("")
  country   String   @default("")
  phone     String   @default("")
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Store policies (refund, privacy, ...). One row per fixed key; empty content = not published.
model Policy {
  key       String   @id
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}

// Online store content pages (About, Shipping policy, ...), shown at /<market>/pages/<handle>.
model Page {
  id             String   @id @default(cuid())
  title          String
  handle         String   @unique
  content        String   @db.Text
  visible        Boolean  @default(true)
  seoTitle       String   @default("")
  seoDescription String   @default("") @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Setting {
  key   String @id
  value String @db.Text
}

// Files live in the upload dir as <id>.webp (full) and <id>-thumb.webp. Position 0 is the cover.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  alt       String   @default("")
  position  Int      @default(0)
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([productId, position])
}

// One row per email we tried to send (also used to send each confirmation only once).
model EmailLog {
  id        String   @id @default(cuid())
  orderId   String?
  kind      String // order_confirmation | payment_link | test
  toEmail   String
  subject   String
  status    String // sent | failed | skipped
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([orderId, kind])
}

// ---- collections ----
// manual: hand-picked products (CollectionProduct). smart: `rules` JSON {match:"all"|"any", conditions:[{field,value}]} evaluated at read time.
model Collection {
  id             String   @id @default(cuid())
  title          String
  handle         String   @unique
  description    String   @db.Text
  kind           String   @default("manual") // manual | smart
  rules          String   @db.Text // JSON, smart collections only
  visible        Boolean  @default(true)
  seoTitle       String   @default("")
  seoDescription String   @default("") @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  products       CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

// ---- blog ----
model BlogPost {
  id             String    @id @default(cuid())
  title          String
  handle         String    @unique
  excerpt        String    @default("") @db.VarChar(500)
  content        String    @db.Text
  author         String    @default("")
  tags           String    @db.Text // JSON array
  coverImage     String    @default("") @db.VarChar(500) // image URL (from the upload dir or any https image)
  published      Boolean   @default(false)
  publishedAt    DateTime? // shown date; future date = scheduled
  seoTitle       String    @default("")
  seoDescription String    @default("") @db.VarChar(500)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---- gift cards ----
// code is random, never derived from anything guessable. balance is minor units in `currency`; cards only work in markets with that currency.
model GiftCard {
  id             String   @id @default(cuid())
  code           String   @unique
  currency       String
  initialAmount  Int
  balance        Int
  active         Boolean  @default(true)
  expiresAt      DateTime?
  recipientEmail String?
  note           String   @db.Text
  orderId        String?  // order that sold it (customer purchase)
  orderItemId    String?
  createdAt      DateTime @default(now())
  txs            GiftCardTx[]

  @@index([orderItemId])
}

// Ledger: amount < 0 spends, > 0 adds. A redeem is reserved when checkout starts and given back (kind "release") if the order never gets paid.
model GiftCardTx {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId    String?
  amount     Int
  kind       String   // issue | redeem | release | adjust
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// ---- security + integrations ----
// Who did what. Never stores passwords, tokens or card data.
model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  userId    String?
  userEmail String   @default("")
  action    String
  detail    String   @default("") @db.VarChar(500)
  ip        String   @default("")

  @@index([at])
}

// Bearer tokens for scripts and outside tools. Only the sha256 is stored; the secret is shown once. Permissions come from the role.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String    // first chars, to recognise the key in the list
  keyHash    String    @unique
  roleId     String
  createdBy  String    @default("")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

// Outbound webhooks ("apps"): POST JSON signed with HMAC-SHA256 to your URL when something happens.
model WebhookEndpoint {
  id        String            @id @default(cuid())
  url       String            @db.VarChar(500)
  events    String            @db.Text // JSON array
  secret    String
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  status     Int             @default(0) // HTTP status, 0 = failed to connect
  error      String          @default("") @db.VarChar(300)
  at         DateTime        @default(now())

  @@index([endpointId, at])
}

// ---- expenses ----
// Money the business spent (stock, packaging, ads...), described by vendor and note. Amounts in minor units of `currency`; reports never add across currencies.
model Expense {
  id             String   @id @default(cuid())
  date           DateTime // the day it was bought (UTC midnight)
  amount         Int
  currency       String   @db.VarChar(3)
  vendor         String   @default("") @db.VarChar(120)
  note           String   @default("") @db.VarChar(500)
  createdById    String?
  createdByEmail String   @default("")
  createdAt      DateTime @default(now())

  @@index([date])
}

// First-party storefront analytics (no personal data): one row per event, grouped by a random per-visit session id.
model TrackEvent {
  id          String   @id @default(cuid())
  sessionId   String   @db.VarChar(40)
  type        String   @db.VarChar(24) // page_view | view_item | add_to_cart | begin_checkout | purchase | page_leave
  path        String   @db.VarChar(300)
  title       String   @default("") @db.VarChar(190)
  market      String   @default("") @db.VarChar(8)
  source      String   @default("direct") @db.VarChar(100) // utm_source, else referrer host group (google, instagram, ...), else direct
  medium      String   @default("") @db.VarChar(100)
  campaign    String   @default("") @db.VarChar(100)
  durationSec Int?     // page_leave: seconds the page was visible and active
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([sessionId])
  @@index([type, createdAt])
}

// One refund against an order: money handed back (Stripe or manually) and, optionally, items returned to stock.
model OrderRefund {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Int
  method         String   @db.VarChar(16) // stripe | manual
  reason         String   @default("") @db.VarChar(300)
  restocked      String   @db.Text // JSON [{title, quantity}]
  stripeRefundId String?  @db.VarChar(80)
  createdByEmail String   @default("") @db.VarChar(190)
  createdAt      DateTime @default(now())

  @@index([orderId])
}

// Storefront discount codes: percent off the items, a fixed amount off, or free shipping.
model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(40)
  kind        String    @db.VarChar(16) // percent | fixed | free_shipping | buy_x_get_y
  value       Int       @default(0) // percent: 1-100; fixed: minor units; free_shipping: 0
  currency    String?   @db.VarChar(3) // fixed codes only work in markets with this currency
  minSubtotal Int       @default(0) // minor units of the items before the code
  startsAt    DateTime?
  endsAt      DateTime?
  buyQty      Int       @default(0) // buy_x_get_y: units that must be bought ...
  getQty      Int       @default(0) // ... to get this many more units
  getPercent  Int       @default(100) // percent off those units (100 = free)
  productId   String?   @db.VarChar(40) // buy_x_get_y: only this product counts (null = any product)
  usageLimit  Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  note        String    @default("") @db.VarChar(200)
  createdAt   DateTime  @default(now())
}

// Old URL -> new URL (e.g. pages from the previous Shopify store), served as 301 by the storefront proxy.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique @db.VarChar(300)
  toPath    String   @db.VarChar(500)
  createdAt DateTime @default(now())
}

// Stock of one variant at one location. The market's InventoryLevel is always >= the sum of its locations' counts;
// the difference is "unassigned" stock (counted per market before locations existed).
model LocationStock {
  variantId  String
  locationId String
  quantity   Int    @default(0)

  @@id([variantId, locationId])
  @@index([locationId])
}

// Moving stock between locations: units leave the source when the transfer is created and arrive when it is received.
model StockTransfer {
  id             String   @id @default(cuid())
  fromLocationId String
  toLocationId   String
  status         String   @default("in_transit") @db.VarChar(16) // in_transit | received | cancelled
  note           String   @default("") @db.VarChar(300)
  createdByEmail String   @default("") @db.VarChar(190)
  createdAt      DateTime @default(now())
  receivedAt     DateTime?
  items          StockTransferItem[]

  @@index([status])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId  String
  title      String        @db.VarChar(250)
  quantity   Int
}

// Storefront customer sign-in without passwords: a 6-digit code emailed to the customer, then a session cookie.
model CustomerLogin {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(190)
  codeHash  String   @db.VarChar(64)
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model CustomerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @db.VarChar(64)
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Product reviews. Verified buyers (signed in, with a paid order containing the product) are approved at once; everyone else waits for moderation.
model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  customerId String?
  name       String   @db.VarChar(80)
  rating     Int
  title      String   @default("") @db.VarChar(120)
  body       String   @db.Text
  status     String   @default("pending") @db.VarChar(12) // pending | approved | rejected
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId, status])
  @@unique([productId, customerId])
}

// Marketing campaign to customers who opted in (CASL): email to acceptsEmail, SMS to acceptsSms.
model Campaign {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(120)
  channel     String    @db.VarChar(8) // email | sms
  subject     String    @default("") @db.VarChar(200)
  body        String    @db.Text // plain text; paragraphs separated by a blank line
  audience    String    @default("all") @db.VarChar(60) // all | buyers | tag:<tag> | market:<CODE>
  status      String    @default("draft") @db.VarChar(10) // draft | sending | sent
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdBy   String    @default("") @db.VarChar(190)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
}
