DATABASE_URL="mysql://utsavvibe:utsavvibe@localhost:3307/utsavvibe"
PORT=4000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# pk_test_… / pk_live_… (public key for the card form on the cart page). Webhook must also send payment_intent.succeeded.
STRIPE_PUBLISHABLE_KEY=
STOREFRONT_URL=http://localhost:5173

# Email (SMTP). Dev uses the local Mailpit container; swap for a real provider in production.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="UtsavVibe <orders@utsavvibe.local>"
MAIL_REPLY_TO=
STORE_NAME=UtsavVibe

# Carrier postage (optional). Free Shippo account: connect carriers + a payment method there, paste the API token here.
SHIPPO_API_KEY=

# Security (production): a long random string. Signs login tokens and encrypts two-factor secrets.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# ---- optional integrations (leave blank to keep them off) ----
# Instagram feed on the storefront home page (long-lived token of a Business/Creator account, lasts 60 days)
INSTAGRAM_ACCESS_TOKEN=
# Meta Conversions API (server-side purchase events). The browser Pixel uses NEXT_PUBLIC_META_PIXEL_ID in the frontend env.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# SMS campaigns (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Stripe Terminal card reader: the Stripe location id the reader is registered to (blank + a test key = simulated reader)
STRIPE_TERMINAL_LOCATION=
